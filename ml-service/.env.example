# Пример настроек микросервиса. Скопируйте в файл .env и задайте свои значения.
ML_API_KEY=замените-на-длинный-случайный-ключ
ML_ENCRYPTION_KEY=замените-на-парольную-фразу-для-шифрования-моделей
ML_MODELS_DIR=models
ML_HOST=127.0.0.1
ML_PORT=8001
# HTTPS между узлами (необязательно): пути к сертификату и ключу в формате PEM
# ML_SSL_CERTFILE=certs/ml-service.crt
# ML_SSL_KEYFILE=certs/ml-service.key
ML_DOCS_ENABLED=true
ML_LOG_LEVEL=INFO
